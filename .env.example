# =============================================================================
# CantiereOS — variabili d'ambiente (ESEMPIO, nessun valore reale)
# Copia in .env.local e compila. Non committare mai file .env con valori veri.
# =============================================================================

# --- Test database (solo sviluppo/CI) ----------------------------------------
# Server PostgreSQL usa-e-getta: i test creano ed eliminano un database proprio.
# MAI un database di produzione.
TEST_DATABASE_URL=

# --- App (apps/web) -----------------------------------------------------------
# Tutte SOLO lato server: nessuna variabile NEXT_PUBLIC_, il browser non parla
# mai direttamente con Supabase o col database.
# In locale: `node scripts/local-auth-env.mjs` genera apps/web/.env.local con
# segreti casuali per lo stack Supabase Auth in Docker (profilo "auth").
APP_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Emittente dei JWT di Supabase Auth, es. https://<progetto>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
# Esattamente UNA delle due: JWT secret (HS256) oppure JWKS delle chiavi asimmetriche
# (es. https://<progetto>.supabase.co/auth/v1/.well-known/jwks.json).
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Connessione PostgreSQL del server (ruolo con membership su authenticated/service_role).
DATABASE_URL=
# Email applicative (inviti). Se vuote l'invio è "non configurato" e l'app lo dice.
SMTP_URL=
MAIL_FROM=
# Solo server (worker e archivio documentale). Mai nel browser, mai NEXT_PUBLIC_.
# Se vuota, l'archivio documentale mostra "Archiviazione file non configurata".
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVATO di Supabase Storage per i documenti (creato al primo uso se manca).
DOCUMENTS_BUCKET=documents
# Bucket PRIVATO per le foto scattate nei moduli compilabili (stessa chiave di servizio).
FORMS_BUCKET=form-files

# --- Redis (code asincrone, fase 2) ------------------------------------------
REDIS_URL=

# --- Object storage S3-compatibile (alternativa futura a Supabase Storage) -----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
