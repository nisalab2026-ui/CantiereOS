# =============================================================================
# CantiereOS — variabili d'ambiente (ESEMPIO, nessun valore reale)
# Copia in .env.local e compila. Non committare mai file .env con valori veri.
# =============================================================================

# --- Test database (solo sviluppo/CI) ----------------------------------------
# Server PostgreSQL usa-e-getta: i test creano ed eliminano un database proprio.
# MAI un database di produzione.
TEST_DATABASE_URL=

# --- Supabase (fase 2) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server/worker. Mai esporre al browser (niente prefisso NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Redis (code asincrone, fase 2) ------------------------------------------
REDIS_URL=

# --- Object storage S3-compatibile (fase 2) ----------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
